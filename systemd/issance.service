# Reference systemd --user unit. `issance start` generates a copy of this with absolute paths filled
# in at ~/.config/systemd/user/issance.service. Edit + use this directly only if you prefer to manage
# it by hand.
#
#   cp systemd/issance.service ~/.config/systemd/user/
#   (edit the @PLACEHOLDERS@ below)
#   systemctl --user daemon-reload && systemctl --user enable --now issance
#
# `cli/unit.test.ts` asserts this file and the generator declare the same directives, so the two
# cannot drift.

[Unit]
Description=issance
After=default.target
# Never give up restarting — a phone-only operator can't run 'systemctl reset-failed'.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@PLUGIN_ROOT@
ExecStart=@PLUGIN_ROOT@/bin/issance _exec-bridge
Restart=on-failure
RestartSec=5
# Hardening: the bridge is remote shell access, so deny privilege escalation and give it a private
# /tmp. ProtectSystem is intentionally NOT set — the only write path is the env-driven state dir,
# which Hangar may inject to an arbitrary location, so it can't be enumerated in a static ReadWritePaths.
NoNewPrivileges=yes
PrivateTmp=yes
Environment=HERDR_SOCKET_PATH=%h/.config/hangar/herdr.sock
Environment=ISSANCE_PORT=8787
Environment=HERDR_PLUGIN_CONFIG_DIR=%h/.config/issance
Environment=ISSANCE_PLUGIN_ROOT=@PLUGIN_ROOT@
# Leading '-': a missing .env is not a startup failure.
EnvironmentFile=-%h/.config/issance/.env

[Install]
WantedBy=default.target
